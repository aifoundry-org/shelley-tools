# shelley-command-hooks configuration.
#
# This is the ONE place with environment-specific values. install.sh copies
# this to config.env (gitignored) and fills in detected defaults; edit as
# needed. It is sourced by the bash scripts AND parsed by command-dispatch.py,
# so keep it to simple KEY=VALUE lines (no shell expansion, no spaces around =).

# Absolute path to the shelley source checkout that rebase/swap operate on.
SHELLEY_REPO=/home/exedev/src/shelley

# The systemd unit for the running shelley, and the live binary it executes.
SHELLEY_SVC=shelley.service
SHELLEY_LIVE_BIN=/usr/local/bin/shelley

# Local URL the running shelley serves on (used for swap health-checks).
SHELLEY_SOCK_URL=http://127.0.0.1:9999/

# The OS user the service runs as (swap preflight runs the candidate binary as
# this user, from a neutral cwd, to exercise the same startup gate systemd will).
SHELLEY_SVC_USER=exedev

# Directory where binary backups/snapshots are written and searched for on
# rollback (shelley-backup-* and shelley-prelive-*).
SHELLEY_STATE_DIR=/home/exedev/.config/shelley

# Git remotes + naming used by the `rebase` command. These are git REMOTE
# NAMES (as in `git remote`), not URLs — the URLs live in the shelley repo's
# own .git/config. For reference, the expected wiring is:
#   upstream = the mainline you rebase onto (release tags live here)
#              remote `origin`  -> https://github.com/boldsoftware/shelley.git
#   fork     = your downstream fork whose commits get replayed
#              remote `ainekko` -> https://github.com/aifoundry-org/shelley.git
# (The `ainekko` name is historical — it now points at the aifoundry-org fork.)
SHELLEY_UPSTREAM_REMOTE=origin
SHELLEY_FORK_REMOTE=ainekko
SHELLEY_FORK_BRANCH=main
# Prefix for the branch `rebase <tag>` creates, e.g. ainekko-<tag>.
SHELLEY_BRANCH_PREFIX=ainekko-
