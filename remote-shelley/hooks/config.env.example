# remote-shelley configuration.
#
# This is the ONE place with environment-specific values. install.sh copies
# this to config.env (gitignored) and fills in detected defaults; edit as
# needed. It is sourced by the bash scripts AND parsed by command-dispatch.py,
# so keep it to simple KEY=VALUE lines (no shell expansion, no spaces around =).

# Local address the proxy binds. This MUST be the same port the local Shelley
# serves on, because exe.dev's native HTTPS proxy already fronts that port —
# taking it over is what makes the remote Shelley appear at the VM's normal
# Shelley URL with TLS termination and auth preserved.
REMOTE_SHELLY_LISTEN=127.0.0.1:9999

# Default upstream Shelley URL when the command is given no argument,
# e.g. a Shelley on your own infra reached over Tailscale.
REMOTE_SHELLY_UPSTREAM=http://aifoundry1:32768

# systemd units for the local Shelley being swapped out.
SHELLEY_SOCKET_UNIT=shelley.socket
SHELLEY_SERVICE_UNIT=shelley.service

# URL used to health-check whichever Shelley should be answering on
# REMOTE_SHELLY_LISTEN after a swap or restore.
REMOTE_SHELLY_SOCK_URL=http://127.0.0.1:9999/

# DEPRECATED / unused: swaps are sticky (guarded by the watchdog), so there is
# no timed auto-restore grace period. Left for backward compatibility with
# older config.env files that set it.
REMOTE_SHELLY_GRACE=5min

# Watchdog: how often to probe the proxy end-to-end (seconds), and how many
# consecutive failures trigger an automatic failover to the local Shelley.
# Default: probe every 15s, fail over after 3 misses (~45s of sustained outage).
REMOTE_SHELLY_WATCH_INTERVAL=15
REMOTE_SHELLY_WATCH_FAILS=3

# Directory for state: last-used upstream, logs.
REMOTE_SHELLY_STATE_DIR=/home/exedev/.config/shelley/remote-shelley
